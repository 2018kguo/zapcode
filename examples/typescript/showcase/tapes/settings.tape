# Shared look for every recording. Run from examples/typescript/showcase:
#   vhs tapes/<name>.tape
Set Shell "bash"
Set FontSize 16
Set FontFamily "Menlo"
Set Width 1300
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms
Set WindowBar Colorful
Set BorderRadius 10
Set Margin 0
Env DEMO_PACE "700"
Env PS1 "\[\e[1;35m\]❯ \[\e[0m\]"
Hide
Type "clear" Enter
Show
