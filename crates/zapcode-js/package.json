{
    "name": "@2018kguo/zapcode-native",
    "version": "1.6.2",
    "description": "Native addon behind @2018kguo/zapcode (install that package instead)",
    "main": "index.js",
    "module": "index.js",
    "types": "index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "require": "./index.js"
        }
    },
    "keywords": [
        "typescript",
        "interpreter",
        "sandbox",
        "ai",
        "mcp",
        "wasm",
        "snapshot",
        "secure"
    ],
    "homepage": "https://github.com/2018kguo/zapcode#readme",
    "bugs": "https://github.com/2018kguo/zapcode/issues",
    "license": "MIT",
    "author": "Kevin Guo",
    "repository": {
        "type": "git",
        "url": "https://github.com/2018kguo/zapcode.git",
        "directory": "crates/zapcode-js"
    },
    "engines": {
        "node": ">=18"
    },
    "files": [
        "index.js",
        "index.d.ts",
        "README.md"
    ],
    "napi": {
        "binaryName": "zapcode",
        "targets": [
            "x86_64-unknown-linux-gnu",
            "x86_64-unknown-linux-musl",
            "aarch64-unknown-linux-gnu",
            "x86_64-apple-darwin",
            "aarch64-apple-darwin",
            "x86_64-pc-windows-msvc",
            "aarch64-pc-windows-msvc"
        ],
        "packageName": "@2018kguo/zapcode-native"
    },
    "scripts": {
        "build": "napi build --release --platform --js index.js --dts napi.generated.d.ts && node -e \"require('fs').rmSync('napi.generated.d.ts',{force:true})\"",
        "prepublishOnly": "napi prepublish -t npm --skip-optional-publish --no-gh-release",
        "artifacts": "napi artifacts"
    },
    "devDependencies": {
        "@napi-rs/cli": "^3.10.9"
    }
}
