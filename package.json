{
  "name": "zapcode-repo",
  "private": true,
  "description": "Repo-level JS/TS tooling (the packages live in crates/ and packages/).",
  "scripts": {
    "lint": "oxlint",
    "fmt": "oxfmt packages/zapcode/src packages/zapcode/tests packages/zapcode/scripts examples/typescript",
    "fmt:check": "oxfmt --check packages/zapcode/src packages/zapcode/tests packages/zapcode/scripts examples/typescript"
  },
  "devDependencies": {
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0"
  },
  "workspaces": [
    "crates/zapcode-js",
    "packages/zapcode",
    "examples/typescript/*"
  ]
}
